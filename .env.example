# Alaskova Education website: every setting it reads. Copy to .env.local for local work, or add the same names in
# Render > Environment. NEVER commit real values. Lines marked SECRET must never be shared or pasted into chats.

# --- Site ---------------------------------------------------------------------------------------------------------
# Public address of this site, no trailing slash. Must match Supabase "Site URL".
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Supabase (Project Settings > API) -------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Bypasses database security; server only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers > API keys / Webhooks) -----------------------------------------------------------------------
# SECRET. sk_test_... in test mode, sk_live_... (or a restricted key) in live mode.
STRIPE_SECRET_KEY=
# SECRET. whsec_... from the webhook endpoint for NEXT_PUBLIC_SITE_URL/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# The monthly price for Molecular Atlas (price_...). Test and live mode have different ids.
STRIPE_PRICE_MOLECULAR_ATLAS=

# --- Molecular Atlas module ------------------------------------------------------------------------------------------
# Where the book is served, e.g. https://atlas.example.com (the site adds /launch).
MODULE_URL_MOLECULAR_ATLAS=
# SECRET. Ed25519 private key (PKCS8 PEM) from `node scripts/generate-module-keys.mjs`. Write line breaks as \n.
ALASKOVA_MODULE_PRIVATE_KEY=
# Key id published in /.well-known/jwks.json. Change it (alaskova-module-2, ...) every time the key is rotated.
ALASKOVA_MODULE_KID=alaskova-module-1
